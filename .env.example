# Local development configuration
# Existing installations: migrate data volumes before changing the project name.
COMPOSE_PROJECT_NAME=full-stack-file-vault

POSTGRES_DB=vault
POSTGRES_USER=vault_admin
POSTGRES_PASSWORD=

# Logical quota defaults to 10,000,000 bytes in PostgreSQL.
# Configure vault.users.quota_bytes with operator credentials; this is not an API env setting.

# API process settings (export explicitly; Go does not load this file).
# start-api.ps1 defaults to loopback development when these are unset.
APP_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:8080

# Global anonymous-session allocations per database minute, shared across replicas.
# Export explicitly for the API; range 1..600. Separate from per-user API limits.
BOOTSTRAP_CREATIONS_PER_MINUTE=60

# Export these settings for the API process; .env is not automatically loaded by Go.
USER_CALLS_PER_SECOND=2
UPLOAD_MAX_FILE_BYTES=20000000
UPLOAD_MAX_REQUEST_BYTES=21000000
UPLOAD_MAX_FILES=10
UPLOAD_MAX_CONCURRENT=4
UPLOAD_STAGING_DIR=data/staging
BLOB_STORAGE_DIR=data/blobs
# Cleanup worker: export GC_DATABASE_URL separately using the vault_gc login.
# It shares BLOB_STORAGE_DIR with the API. Never use the runtime/admin login.
# Local bootstrap: ./scripts/start-gc.ps1 [-Once] manages an ignored credential.
